{
  "name": "dtsanity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Design tokens validator and accessibility checker: DTCG format, contrast (WCAG, APCA) and color blindness, with fixes. Runs in your browser.",
  "keywords": ["design-tokens", "dtcg", "design-system", "validator", "linter", "accessibility", "wcag", "apca", "color-contrast", "color-blindness", "tokens-studio", "style-dictionary", "oklch"],
  "homepage": "https://github.com/avinvadas/DTsanity",
  "repository": { "type": "git", "url": "git+https://github.com/avinvadas/DTsanity.git" },
  "author": "Avin Vadas (https://avinvadas.com)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:strict": "tsc --noEmit && vite build --mode strict",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "colorjs.io": "^0.5.2"
  }
}
