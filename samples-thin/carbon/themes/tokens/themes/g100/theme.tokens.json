{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Carbon Design System theme tokens for the Gray 100 theme.",
  "$extensions": {
    "com.ibm.carbon": {
      "color-scheme": "dark",
      "contextual": [
        "layer",
        "layer-active",
        "layer-hover",
        "layer-selected",
        "layer-selected-hover",
        "layer-accent",
        "layer-accent-hover",
        "layer-accent-active",
        "field",
        "field-hover",
        "border-subtle",
        "border-subtle-selected",
        "border-strong",
        "border-tile"
      ]
    }
  },
  "background": {
    "$type": "color",
    "$value": "{gray.100}",
    "$description": "Default page background color. Use as the base surface for the entire application or page.",
    "$extensions": {
      "com.ibm.carbon": {
        "group": "Background",
        "properties": [
          "background"
        ],
        "layer-set": "base"
      }
    }
  },
  "background-active": {
    "$type": "color",
    "$value": {
      "colorSpace": {
        "$ref": "#/gray/50/$value/colorSpace"
      },
      "components": {
        "$ref": "#/gray/50/$value/components"
      },
      "alpha": 0.4
    },
    "$description": "Background color for active/pressed state. Use when user clicks or presses interactive elements.",
    "$extensions": {
      "com.ibm.carbon": {
        "group": "Background",
        "properties": [
          "background"
        ],
        "state": "active"
      }
    }
  },
  "background-selected": {
    "$type": "color",
    "$value": {
      "colorSpace": {
        "$ref": "#/gray/50/$value/colorSpace"
      },
      "components": {
        "$ref": "#/gray/50/$value/components"
      },
      "alpha": 0.24
    },
    "$description": "Background color for selected state. Use to highlight currently selected items or active states.",
    "$extensions": {
      "com.ibm.carbon": {
        "group": "Background",
        "properties": [
          "background"
        ],
        "state": "selected",
        "layer-set": "base"
      }
    }
  },
  "background-selected-hover": {
    "$type": "color",
    "$value": {
      "colorSpace": {
        "$ref": "#/gray/50/$value/colorSpace"
      },
      "components": {
        "$ref": "#/gray/50/$value/components"
      },
      "alpha": 0.32
    },
    "$description": "Hover state for selected backgrounds. Use when user hovers over already-selected items.",
    "$extensions": {
      "com.ibm.carbon": {
        "group": "Background",
        "properties": [
          "background"
        ],
        "state": "hover",
        "layer-set": "base"
      }
    }
  },
  "background-hover": {
    "$type": "color",
    "$value": {
      "colorSpace": {
        "$ref": "#/gray/50/$value/colorSpace"
      },
      "components": {
        "$ref": "#/gray/50/$value/components"
      },
      "alpha": 0.16
    },
    "$description": "Background color for hover state. Use when user hovers over interactive elements to provide visual feedback.",
    "$extensions": {
      "com.ibm.carbon": {
        "group": "Background",
        "properties": [
          "background"
        ],
        "state": "hover",
        "layer-set": "base"
      }
    }
  },
  "background-brand": {
    "$type": "color",
    "$value": "{blue.60}",
    "$description": "Brand color for backgrounds. Use for branded sections, headers, or promotional areas.",
