{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Inter", "Helvetica Neue", "sans-serif"] },
      "serif": { "$value": ["Source Serif 4", "Georgia", "serif"] },
      "mono": { "$value": "JetBrains Mono" }
    },
    "size": {
      "$type": "dimension",
      "100": { "$value": { "value": 0.75, "unit": "rem" } },
      "200": { "$value": { "value": 0.875, "unit": "rem" } },
      "300": { "$value": { "value": 1, "unit": "rem" } },
      "400": { "$value": { "value": 1.25, "unit": "rem" } },
      "500": { "$value": { "value": 1.5625, "unit": "rem" } },
      "600": { "$value": { "value": 1.953, "unit": "rem" } },
      "700": { "$value": { "value": 2.441, "unit": "rem" } }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": "bold" }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.2 },
      "snug": { "$value": 1.35 },
      "normal": { "$value": 1.5 }
    },
    "tracking": {
      "$type": "dimension",
      "tight": { "$value": { "value": -0.02, "unit": "rem" } },
      "none": { "$value": { "value": 0, "unit": "px" } },
      "wide": { "$value": { "value": 0.05, "unit": "rem" } }
    }
  }
}
